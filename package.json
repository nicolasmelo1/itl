{
  "name": "itl",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "dev:web": "pnpm --filter @itl/web dev",
    "dev:ai": "uv --directory apps/ai run uvicorn --env-file .env itl_ai.main:app --reload",
    "lint": "pnpm --filter @itl/web lint && uv --directory apps/ai run ruff check .",
    "typecheck": "pnpm --filter @itl/web typecheck && uv --directory apps/ai run pyright",
    "test": "pnpm --filter @itl/web test && uv --directory apps/ai run pytest",
    "build": "pnpm --filter @itl/web build && uv --directory apps/ai build",
    "verify:project-setup": "node scripts/verify-project-setup.mjs",
    "verify:controlled-ui-language": "node scripts/verify-controlled-ui-language.mjs",
    "verify:memory-exploration-validation": "node scripts/verify-memory-exploration-validation.mjs",
    "verify:button-contextual-lab": "node scripts/verify-button-contextual-lab.mjs",
    "verify:atomic-foundations": "node scripts/verify-atomic-foundations.mjs",
    "verify:atomic-design-system": "node scripts/verify-atomic-design-system.mjs",
    "verify:multi-component-taste": "node scripts/verify-multi-component-taste.mjs"
  }
}
