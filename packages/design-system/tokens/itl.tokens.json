{
  "$description": "Canonical ITL design tokens. CSS custom properties are a generated projection of this DTCG-shaped source.",
  "font": {
    "family": {
      "sans": { "$type": "fontFamily", "$value": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif" }
    },
    "size": {
      "xs": { "$type": "dimension", "$value": "0.75rem" },
      "sm": { "$type": "dimension", "$value": "0.875rem" },
      "md": { "$type": "dimension", "$value": "1rem" },
      "lg": { "$type": "dimension", "$value": "1.05rem" }
    },
    "weight": {
      "medium": { "$type": "fontWeight", "$value": "500" },
      "semibold": { "$type": "fontWeight", "$value": "650" }
    }
  },
  "line-height": {
    "tight": { "$type": "number", "$value": "1" },
    "normal": { "$type": "number", "$value": "1.5" }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "0.25rem" },
    "2": { "$type": "dimension", "$value": "0.35rem" },
    "3": { "$type": "dimension", "$value": "0.45rem" },
    "4": { "$type": "dimension", "$value": "0.5rem" },
    "5": { "$type": "dimension", "$value": "0.55rem" },
    "6": { "$type": "dimension", "$value": "0.6rem" },
    "7": { "$type": "dimension", "$value": "0.65rem" },
    "8": { "$type": "dimension", "$value": "0.75rem" },
    "9": { "$type": "dimension", "$value": "0.875rem" },
    "10": { "$type": "dimension", "$value": "0.9rem" },
    "12": { "$type": "dimension", "$value": "1rem" },
    "14": { "$type": "dimension", "$value": "1.25rem" }
  },
  "border": {
    "width": {
      "default": { "$type": "dimension", "$value": "1px" }
    }
  },
  "radius": {
    "none": { "$type": "dimension", "$value": "0" },
    "sm": { "$type": "dimension", "$value": "0.4rem" },
    "md": { "$type": "dimension", "$value": "0.6rem" },
    "full": { "$type": "dimension", "$value": "999px" }
  },
  "shadow": {
    "raised": { "$type": "shadow", "$value": "0 12px 30px rgb(22 29 41 / 12%)" }
  },
  "motion": {
    "fast": { "$type": "duration", "$value": "150ms" }
  },
  "size": {
    "control": {
      "compact": { "$type": "dimension", "$value": "2rem" },
      "regular": { "$type": "dimension", "$value": "2.5rem" }
    }
  },
  "focus": {
    "ring-width": { "$type": "dimension", "$value": "3px" }
  },
  "color": {
    "accent": { "$type": "color", "$value": "#4f46e5" },
    "accent-strong": { "$type": "color", "$value": "#3730a3" },
    "accent-muted": { "$type": "color", "$value": "#e0e7ff" },
    "accent-ink": { "$type": "color", "$value": "#312e81" },
    "border": { "$type": "color", "$value": "#c9cbd2" },
    "success-muted": { "$type": "color", "$value": "#dcfce7" },
    "success-ink": { "$type": "color", "$value": "#166534" },
    "surface": { "$type": "color", "$value": "#ffffff" },
    "surface-raised": { "$type": "color", "$value": "#f4f4f6" },
    "text": { "$type": "color", "$value": "#1d2027" },
    "text-inverse": { "$type": "color", "$value": "#ffffff" },
    "text-muted": { "$type": "color", "$value": "#5f6470" }
  },
  "focus-ring": { "$type": "color", "$value": "#f59e0b" }
}
