# Keep deterministic fixtures (no network or key) unless a provider is selected.
ITL_LLM_PROVIDER=deterministic
PREFERENCE_DATABASE_PATH=data/preferences.db

# Ollama Cloud. Create a key at ollama.com and choose a cloud model available to your account.
# ITL_LLM_PROVIDER=ollama
# OLLAMA_API_KEY=
# OLLAMA_BASE_URL=https://ollama.com/v1
# OLLAMA_MODEL=gpt-oss:120b-cloud
# LLM_TIMEOUT_SECONDS=120

# OpenAI API. A Codex/ChatGPT subscription signs you into Codex, but this server
# needs a separate API project key and API credits/billing for programmatic calls.
# ITL_LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
